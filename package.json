{
  "name": "flipfile",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "fonts": "node scripts/fetch-fonts.mjs",
    "samples": "node samples/make-samples.mjs",
    "predev": "npm run fonts --silent",
    "dev": "vite",
    "prebuild": "npm run fonts --silent",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "typecheck": "tsc -b --noEmit",
    "build:pages": "tsc -b && vite build --base=/flipfile/"
  },
  "dependencies": {
    "jszip": "^3.10.1",
    "pdf-fontkit": "^1.8.9",
    "pdf-lib": "^1.17.1",
    "pdfjs-dist": "^4.8.69",
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@vitejs/plugin-react": "^4.3.4",
    "typescript": "^5.6.3",
    "vite": "^5.4.11"
  }
}
